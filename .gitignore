# Dependencies
.DS_Store
*.swp
*.log

# Results (keep templates only in git; commit run summaries optionally)
docs/results/run_*/
!docs/results/templates/

# SDV generated parquet (large)
sdv/output/
sdv/output/**/*
!sdv/output/.gitkeep

# Local config overrides
config/local/
.env
*.keytab

# Apache Flink vendor copy (bootstrap_flink_sql_client.sh)
flink/vendor/apache-flink-*/
!flink/vendor/.gitkeep

# Generated SQL with secrets
**/logs/

# Python
__pycache__/
.venv/
