# Bash-safe .env — KT KDAP PoC (jshin CDP 7.3.2)
# Rules:
#   1) Quote values that contain spaces: KEY="value with spaces"
#   2) SPARK_CONF_* names must use underscores only (scripts map _ → . for Spark)
#   3) Copy to .env: cp .env.example .env

# ── Python (CDP edge) ──
# python → 2.7, python3 → 3.8 (parcel) — do NOT use for this project.
# Use python3.11 (3.11.11) for SDV, venv, and helpers.
PYTHON=python3.11

# ── CDP cluster ──
CDP_VERSION=7.3.2
FLINK_VERSION=1.20.1

# ── CDP Spark connection ──
CDP_SPARK_MASTER=yarn
SPARK_QUEUE=default

# ── Kerberos (CDP secure cluster) ──
KERBEROS_PRINCIPAL=systest@QE-INFRA-AD.CLOUDERA.COM
KERBEROS_KEYTAB=/cdep/keytabs/systest.keytab
SPARK_YARN_PRINCIPAL=systest@QE-INFRA-AD.CLOUDERA.COM
SPARK_YARN_KEYTAB=/cdep/keytabs/systest.keytab

# ── HDFS HA (lab nameservice ns1) ──
HADOOP_CONF_DIR=/etc/hadoop/conf
HDFS_NAMESERVICE=ns1
HDFS_DEFAULT_FS=hdfs://ns1
HDFS_STAGING_PATH=/user/kdap/staging/sdv
SPARK_CONF_spark_hadoop_fs_defaultFS=hdfs://ns1

# ── Auto-TLS truststore ──
TRUSTSTORE_PATH=/var/lib/cloudera-scm-agent/agent/cert/cm-auto-global_cacerts.jks
TRUSTSTORE_PASSWORD=changeit
TRUSTSTORE_TYPE=JKS

# ── Impala (TLS + Kerberos) ──
IMPALA_HOST=ccycloud-5.jshin.root.comops.site
IMPALA_PORT=25003
IMPALA_SSL_CA_CERT=/var/lib/cloudera-scm-agent/agent-cert/cm-auto-global_cacerts.pem

# ── Hive Metastore (Flink Iceberg catalog) ──
HMS_URI=thrift://ccycloud-5.jshin.root.comops.site:9083
ICEBERG_WAREHOUSE=hdfs://ns1/user/hive/warehouse

# ── Iceberg / KT KDAP target ──
ICEBERG_CATALOG=spark_catalog
TARGET_DATABASE=kdap
FLINK_ICEBERG_CATALOG=iceberg_hive_catalog

# Flink sink / source tables (PoC)
TABLE_BTS_MASTER=bts_master
TABLE_CDR_SGI_RAW=cdr_sgi_raw
TABLE_CDR_MDT_RAW=cdr_mdt_smsng_raw
TABLE_LTAS_SINK=ltas_5min_flink
TABLE_SGI_SINK=sgi_5min_flink
TABLE_SGI_SINK_V2=sgi_5min_flink_v2
TABLE_MDT_SINK=mdt_5min_flink

# ── Flink paths (CDP parcel) ──
FLINK_HOME=/opt/cloudera/parcels/FLINK/lib/flink

# ── SDV data generation defaults ──
SDV_SCALE_BTS=5000
SDV_SCALE_SGI=1000000
SDV_SCALE_MDT=1000000
SDV_OUTPUT_DIR=sdv/output
SDV_FILTER_PASS_RATIO=0.85
SDV_HOURS_SPAN=6

# ── Spark / Iceberg (SPARK_CONF_ + underscores → spark.dotted.keys) ──
SPARK_CONF_spark_sql_catalog_spark_catalog=org.apache.iceberg.spark.SparkCatalog
SPARK_CONF_spark_sql_catalog_spark_catalog_type=hive
SPARK_CONF_spark_sql_extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions
SPARK_CONF_spark_log_level=ERROR

# ── Spark resources (SDV Parquet → Iceberg load) ──
SPARK_EXECUTOR_MEMORY=8g
SPARK_DRIVER_MEMORY=4g
SPARK_NUM_EXECUTORS=4

# Safety gate for destructive operations
CDP_ALLOW_DESTRUCTIVE=false
